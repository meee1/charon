{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-ofdm-file-transfer",
            "type": "shell",
            "command": "make",
            "args": [
                "ofdm_file_transfer"
            ],
            "options": {
                "cwd": "${workspaceFolder}/example"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
