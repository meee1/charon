NAME = charon-host
SUFFIX ?= .c
DIRS ?= .

# Exclude pluto.c from build, use pluto_host.c instead
EXCLUDE_SRC = pluto.c

# Host architecture build - no cross-compilation
ARCH := $(shell uname -m)
CROSS_COMPILE =
SYSROOT =

LIBTUNTAP_BUILD := ./third_party/libtuntap/build_host

FLAGS ?= -O0 -std=gnu99 -ggdb \
        -I./third_party/libtuntap/\
        -I$(LIBTUNTAP_BUILD)\
        -D_FILE_OFFSET_BITS=64

# For host build, only link libraries actually used (pluto_host.c replaces
# pluto.c so libiio/libad9361/libserialport/libavahi are not needed)
LDFLAGS ?= -ggdb \
           -L ./third_party/libfec\
           -L $(LIBTUNTAP_BUILD)/lib\
           -lm -lliquid -lfftw3f \
           -Wl,-Bstatic -lfec -ltuntap \
           -Wl,-Bdynamic

PLATFORM := $(shell uname -s)

-include Make.config

OUT_DIR := .build_host
# Get all source files, explicitly excluding pluto.c and pluto_host.c from wildcard
ALL_SRC := $(wildcard charon.c config.c crc.c glibc_compat.c ofdm_rx.c ofdm_tx.c tap_device.c tcp_subs.c timers.c util.c)
# Add pluto_host.c (not pluto.c)
SRC := $(ALL_SRC) pluto_host.c
OBJ_ := $(SRC:$(SUFFIX)=.o)
OBJ := $(addprefix $(OUT_DIR)/,$(OBJ_))
DEPS := $(OBJ:.o=.d)
SHARED_SUFFIX := dll
STATIC_SUFFIX := lib

ifeq "$(PLATFORM)" "Linux"
    SHARED_SUFFIX := so
    STATIC_SUFFIX := a
endif

ifeq "$(LIBRARY)" "shared"
    OUT=lib$(NAME).$(SHARED_SUFFIX)
    LDFLAGS += -shared
else ifeq "$(LIBRARY)" "static"
    OUT=lib$(NAME).$(STATIC_SUFFIX)
else
    OUT=$(NAME)
endif

ifeq "$(SUFFIX)" ".cpp"
    COMPILER := $(CXX)
else ifeq "$(SUFFIX)" ".c"
    COMPILER := gcc
endif

.SUFFIXES:
.PHONY: all clean clean-deps deps host-test

all: $(OUT)

$(OUT): $(OBJ) | deps
ifeq "$(LIBRARY)" "static"
	@$(AR) rcs $@ $^
else
	@echo $(COMPILER) $^ $(LDFLAGS) -o $@
	@$(COMPILER) $^ $(LDFLAGS) -o $@
endif

$(OUT_DIR)/%.o: %$(SUFFIX) | deps
	@mkdir -p $(dir $@)
	@echo $(COMPILER) $(CXXFLAGS) $(FLAGS) -MMD -MP -fPIC -c $< -o $@
	@$(COMPILER) $(CXXFLAGS) $(FLAGS) -MMD -MP -fPIC -c $< -o $@

# Build third-party static libraries needed for host mode
deps:
	@echo "Building libfec..."
	@cd third_party/libfec && ([ -f libfec.a ] || (chmod +x configure && ./configure && make))
	@echo "Building libtuntap..."
	@cmake -B $(LIBTUNTAP_BUILD) -DENABLE_CXX=OFF -DENABLE_PYTHON=OFF third_party/libtuntap > /dev/null 2>&1
	@cmake --build $(LIBTUNTAP_BUILD) > /dev/null 2>&1
	@echo "Dependencies ready."

clean:
	@$(RM) -r $(OUT) $(OUT_DIR)

clean-deps:
	@$(RM) -r $(LIBTUNTAP_BUILD)
	@$(MAKE) -C third_party/libfec clean > /dev/null 2>&1 || true

# Run the host-mode test suite (requires root for TAP device tests)
host-test: all
	@bash tests/test_host.sh

-include: $(DEPS)
